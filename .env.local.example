NEXT_PUBLIC_SUPABASE_URL=https://tvuj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvuj-anon-key

# POZOR: tento klíč NIKDY nesmí mít prefix NEXT_PUBLIC_ a nesmí se objevit v žádném
# klientském (prohlížečovém) kódu — používá se jen na serveru v app/api/* routách,
# pro veřejnou stránku podpisu předávacího protokolu bez přihlášení.
SUPABASE_SERVICE_ROLE_KEY=tvuj-service-role-key

# Pro ukládání fotek (účtenky, fotodokumentace, podpisy) do sdílené složky na Google Drive
# místo Supabase Storage. Návod na založení je v README.md. Klíč je jen na serveru.
GOOGLE_DRIVE_FOLDER_ID=id-sdilene-slozky-na-disku

# DOPORUČENÁ VARIANTA — vlož sem přesně celý obsah staženého .json souboru servisního
# účtu (nic nevystřihávej, celé i se složenými závorkami). Nejmíň náchylné na chybu.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", ...}

# ALTERNATIVA (starší, náchylnější na chybu při ručním kopírování) — použij JEN pokud
# GOOGLE_SERVICE_ACCOUNT_JSON výše nepoužíváš:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nazev@projekt.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

NEXT_PUBLIC_SUPABASE_URL=https://tvuj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvuj-anon-key

# POZOR: tento klíč NIKDY nesmí mít prefix NEXT_PUBLIC_ a nesmí se objevit v žádném
# klientském (prohlížečovém) kódu — používá se jen na serveru v app/api/* routách,
# pro veřejnou stránku podpisu předávacího protokolu bez přihlášení.
SUPABASE_SERVICE_ROLE_KEY=tvuj-service-role-key

# Pro ukládání fotek (účtenky, fotodokumentace, podpisy) a PDF archivů na Google Drive
# místo Supabase Storage. Appka se přihlašuje jako konkrétní lidský Google účet (OAuth),
# ne jako servisní účet — návod na založení je v README.md.
GOOGLE_OAUTH_CLIENT_ID=tvuje-cislo.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tvuj-client-secret
GOOGLE_DRIVE_FOLDER_ID=id-sdilene-slozky-na-disku
